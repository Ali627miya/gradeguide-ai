# Copy this file to ".env" (same folder) and fill in the values.

# Optional. Leave blank to run the clearly-labelled OFFLINE SIMULATOR (no AI, no cost).
OPENAI_API_KEY=
# Any chat model your key can use that supports JSON mode.
OPENAI_MODEL=gpt-4o-mini
# auto = use OpenAI when a key is set; offline = never call OpenAI (good for rehearsing without Wi-Fi)
AI_MODE=auto

# Change this to any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Non-demo drafts older than this many days are deleted automatically at startup.
RETENTION_DAYS=30
# Class analytics are hidden for cohorts smaller than this.
MIN_COHORT_SIZE=5
MAX_UPLOAD_MB=10
MAX_QUESTIONS_PER_SECTION=6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
